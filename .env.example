# Spotify Developer App Credentials
# Create yours at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Redirect URI (must exactly match what is registered in your Spotify Developer App settings)
# For local testing:
REDIRECT_URI=http://localhost:3000/auth/callback
# When deployed to cloud (e.g. Render/Railway):
# REDIRECT_URI=https://your-app-name.onrender.com/auth/callback

# Server Port
PORT=3000
